    "moment": "^2.30.1",
    "moment-timezone": "^0.5.48",
    "my-orders-tickets-widget": "1.0.22",
    "openstack-uicore-foundation": "4.2.34",
    "react-bootstrap": "^0.33.1",
    "react-datetime": "^2.16.2",
    "react-dnd": "^16.0.0",
    "react-dnd-html5-backend": "^16.0.0",
    "react-dropzone": "^4.2.9",
    "react-final-form": "^6.5.9",
    "react-google-maps": "^9.4.5",
    "react-redux": "^7.2.9",
    "react-rte": "^0.16.3",
    "react-select": "^2.4.3",
    "react-star-ratings": "^2.3.0",
    "react-stars": "^2.2.5",
    "react-tooltip": "^3.11.1",
    "redux": "^4.2.1",
    "redux-persist": "^5.10.0",
    "redux-thunk": "^2.4.2",
    "schedule-filter-widget": "3.0.8",
    "spark-md5": "^3.0.2",
    "speakers-widget": "4.0.2",
    "summit-registration-lite": "7.0.10",
    "superagent": "^3.8.3",
    "sweetalert2": "^11.26.25",
    "upcoming-events-widget": "3.0.7",
    "urijs": "^1.19.1",
    "validator": "^9.4.1",
    "video.js": "^7.8.2"
  },
  "devDependencies": {
    "@mui/material": "^9.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
