{
  "name": "@openeventkit/widgets",
  "version": "0.1.0",
  "private": true,
  "description": "Bridge layer for legacy React 16 / Redux / uicore-4 widget packages consumed by a host event site. Isolates the legacy dep tree from the host, and re-exports the mount/core surfaces as ./mount and ./core subpaths so a host needs only this one widget dependency.",
  "type": "module",
  "bin": {
    "widgets-assets": "./scripts/copy-assets.mjs"
  },
  "scripts": {
    "assets": "node scripts/generate-assets.mjs"
  },
  "exports": {
    "./registration/manifest": "./src/catalog/registration/manifest.tsx",
    "./schedule-full/manifest": "./src/catalog/schedule-full/manifest.tsx",
    "./schedule-lite/manifest": "./src/catalog/schedule-lite/manifest.ts",
    "./schedule-filters/manifest": "./src/catalog/schedule-filters/manifest.ts",
    "./event-feedback/manifest": "./src/catalog/event-feedback/manifest.ts",
    "./my-tickets/manifest": "./src/catalog/my-tickets/manifest.ts",
    "./extra-questions/manifest": "./src/catalog/extra-questions/manifest.ts",
    "./upcoming-events/manifest": "./src/catalog/upcoming-events/manifest.ts",
    "./live-event/manifest": "./src/catalog/live-event/manifest.ts",
    "./speakers/manifest": "./src/catalog/speakers/manifest.ts",
    "./webpack-compat": "./src/lib/webpack-compat.ts",
    "./uicore-host": "./src/lib/uicore-host.ts",
    "./shadow-root-context": "./src/lib/context/shadow-root-context.ts",
    "./compat/uicore-ajaxloader": "./src/lib/compat/uicore-ajaxloader.tsx",
    "./compat/uicore-i18n": "./src/lib/compat/uicore-i18n.ts",
    "./compat/uicore-swal": "./src/lib/compat/uicore-swal.ts",
    "./package.json": "./package.json",
    "./core": "./src/core/index.ts",
    "./core/*": "./src/core/*.ts",
    "./mount": "./src/mount/index.ts",
    "./mount/renderers/react-component": "./src/mount/renderers/react-component.tsx",
    "./mount/renderers/web-component": "./src/mount/renderers/web-component.tsx",
    "./mount/compat/*": "./src/mount/compat/*.ts",
    "./host": "./src/mount/configureWidgetHost.ts",
    "./event-feedback/web-component": "./src/catalog/event-feedback/web-component.tsx",
    "./event-feedback/react": "./src/catalog/event-feedback/react.tsx",
    "./extra-questions/react": "./src/catalog/extra-questions/react.tsx",
    "./live-event/web-component": "./src/catalog/live-event/web-component.tsx",
    "./live-event/react": "./src/catalog/live-event/react.tsx",
    "./my-tickets/web-component": "./src/catalog/my-tickets/web-component.tsx",
    "./my-tickets/react": "./src/catalog/my-tickets/react.tsx",
    "./registration/web-component": "./src/catalog/registration/web-component.tsx",
    "./registration/react": "./src/catalog/registration/react.tsx",
    "./schedule-filters/web-component": "./src/catalog/schedule-filters/web-component.tsx",
    "./schedule-filters/react": "./src/catalog/schedule-filters/react.tsx",
    "./schedule-full/web-component": "./src/catalog/schedule-full/web-component.tsx",
    "./schedule-full/react": "./src/catalog/schedule-full/react.tsx",
    "./schedule-lite/web-component": "./src/catalog/schedule-lite/web-component.tsx",
    "./schedule-lite/react": "./src/catalog/schedule-lite/react.tsx",
    "./speakers/web-component": "./src/catalog/speakers/web-component.tsx",
    "./speakers/react": "./src/catalog/speakers/react.tsx",
    "./upcoming-events/web-component": "./src/catalog/upcoming-events/web-component.tsx",
    "./upcoming-events/react": "./src/catalog/upcoming-events/react.tsx"
  },
