    "awesome-bootstrap-checkbox": "^2.0.1",
    "bootstrap": "3.4.1",
    "browser-tabs-lock": "^1.2.15",
    "chain-function": "^1.0.1",
    "crypto-js": "^4.2.0",
    "dom-helpers": "^3.4.0",
    "dropzone": "^5.7.2",
    "event-feedback-widget": "2.0.1",
    "extend": "^3.0.1",
    "final-form": "^4.20.10",
    "font-awesome": "4.7.0",
    "full-schedule-widget": "3.1.3",
    "history": "^4.7.2",
